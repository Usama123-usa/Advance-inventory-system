# ============================================================================
# Premium Inventory Management & POS System — Environment Variables
# Copy this file to `.env` in the project root (for local backend dev) and
# also set the same values in your Vercel Project Settings -> Environment Variables.
#
# The backend talks to Postgres exclusively through the Supabase client
# (PostgREST + RPC) — there is no raw database connection string to manage.
# ============================================================================

# Server
PORT=5000
NODE_ENV=development

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret key (full access, bypasses Row Level Security) — server-side only, never expose to the frontend.
SUPABASE_SECRET_KEY=your-secret-key

# Publishable key — safe for client-side use. Not required by this backend today
# (kept here in case you later call Supabase directly from the frontend for anything).
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

SUPABASE_STORAGE_BUCKET=product-images

# JWT Authentication (this app uses its own users table + JWT, not Supabase Auth,
# so SUPABASE_JWKS_URL is not used by the code)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Password hashing
BCRYPT_ROUNDS=10

# CORS - comma separated list of allowed origins, or * for all
CORS_ORIGIN=http://localhost:5173

# Frontend (client/.env) — Vite only exposes vars prefixed with VITE_
VITE_API_URL=http://localhost:5000/api

